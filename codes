# ===== server.js =====
$server = @'
const express = require('express');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = 3000;

app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

const vehicles = [
  { id: 1, name: 'Family SUV',        category: 'SUV',    price: 3200000, note: 'Spacious, safe and fuel efficient.' },
  { id: 2, name: 'Compact SUV',       category: 'SUV',    price: 2600000, note: 'City-friendly with room to spare.' },
  { id: 3, name: 'Executive Sedan',   category: 'Sedan',  price: 2400000, note: 'Comfort and style on every road.' },
  { id: 4, name: 'Economy Sedan',     category: 'Sedan',  price: 1500000, note: 'Reliable and easy on fuel.' },
  { id: 5, name: 'Double Cab Pickup', category: 'Pickup', price: 4100000, note: 'Built for work and adventure.' },
  { id: 6, name: 'Single Cab Pickup', category: 'Pickup', price: 3100000, note: 'Tough, simple, dependable.' }
];

app.get('/api/vehicles', (req, res) => res.json(vehicles));

app.post('/api/contact', (req, res) => {
  const { name, phone, message } = req.body || {};
  if (!name || !phone || !message) {
    return res.status(400).json({ ok: false, error: 'Please fill in all fields.' });
  }
  const file = path.join(__dirname, 'messages.json');
  let list = [];
  try { list = JSON.parse(fs.readFileSync(file, 'utf8')); } catch (e) {}
  list.push({ name, phone, message, date: new Date().toISOString() });
  fs.writeFileSync(file, JSON.stringify(list, null, 2));
  res.json({ ok: true });
});

app.listen(PORT, () => console.log('Murithi Motors running at http://localhost:' + PORT));
'@
Set-Content -Path "$Root\server.js" -Value $server -Encoding UTF8

